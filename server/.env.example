# EventPilot Server Environment Configuration

PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Firebase Realtime Database
FIREBASE_DATABASE_URL=https://your-firebase-project-rtdb.firebaseio.com
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_KEY=./serviceAccountKey.json

# JWT Auth Secret
JWT_SECRET=your_jwt_secret_hex_key

# Google Gemini API & Multi-Model Fallback Configuration
GEMINI_API_KEY=your_gemini_api_key

# Primary Model: default is gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# Multi-Model Fallback Chain: ordered comma-separated list of fallback models
GEMINI_FALLBACK_MODELS=gemini-2.0-flash,gemini-1.5-flash,gemini-2.5-pro

# Alternatively, set full model priority chain directly:
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.0-flash,gemini-1.5-flash,gemini-2.5-pro
