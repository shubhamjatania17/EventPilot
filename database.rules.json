{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid",
        "profile": {
          ".validate": "newData.hasChildren(['email', 'displayName'])"
        },
        "events": {
          "$eventId": {
            ".validate": "newData.hasChildren(['meta'])"
          }
        }
      }
    },
    "indexes": {
      ".read": false,
      ".write": false
    }
  }
}
